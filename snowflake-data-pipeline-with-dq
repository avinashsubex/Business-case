('O4','2026-01-02','C3','P3',NULL,150,CURRENT_TIMESTAMP()); -- duplicate row


-- ✅ STEP 5 — Create STAGING Table (Clean Layer)
CREATE OR REPLACE TABLE STG_SALES AS
SELECT
    ORDER_ID,
    ORDER_DATE,
    CUSTOMER_ID,
    PRODUCT_ID,
    COALESCE(QUANTITY, 0) AS QUANTITY,
    PRICE,
    QUANTITY * PRICE AS TOTAL_AMOUNT,
    UPDATED_AT
FROM RAW_SALES;


-- ✅ STEP 6 — Create MART Table (Aggregated Layer)
CREATE OR REPLACE TABLE MART_DAILY_SALES AS
SELECT
    ORDER_DATE,
    SUM(TOTAL_AMOUNT) AS DAILY_REVENUE,
    COUNT(DISTINCT ORDER_ID) AS TOTAL_ORDERS
FROM STG_SALES
GROUP BY ORDER_DATE;


-- ✅ STEP 7 — Create Data Quality Results Table
CREATE OR REPLACE TABLE DATA_QUALITY_RESULTS (
    CHECK_NAME STRING,
    CHECK_STATUS STRING,
    CHECK_VALUE STRING,
    CHECK_TIMESTAMP TIMESTAMP
);

-- ✅ STEP 8 — Data Quality Checks
-- 1️⃣ Row Count Check
INSERT INTO DATA_QUALITY_RESULTS
SELECT
    'ROW_COUNT_CHECK',
    CASE 
        WHEN (SELECT COUNT(*) FROM RAW_SALES) = 
             (SELECT COUNT(*) FROM STG_SALES)
        THEN 'PASS'
        ELSE 'FAIL'
    END,
    (SELECT COUNT(*) FROM RAW_SALES)::STRING,
    CURRENT_TIMESTAMP();


-- 2️⃣ Null Check
INSERT INTO DATA_QUALITY_RESULTS
SELECT
    'NULL_CHECK_QUANTITY',
    CASE 
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END,
    COUNT(*)::STRING,
    CURRENT_TIMESTAMP()
FROM RAW_SALES
WHERE QUANTITY IS NULL;

-- 3️⃣ Duplicate Check
INSERT INTO DATA_QUALITY_RESULTS
SELECT
    'DUPLICATE_ORDER_CHECK',
    CASE 
        WHEN COUNT(*) = 0 THEN 'PASS'
        ELSE 'FAIL'
    END,
    COUNT(*)::STRING,
    CURRENT_TIMESTAMP()
FROM (
    SELECT ORDER_ID
    FROM RAW_SALES
    GROUP BY ORDER_ID
    HAVING COUNT(*) > 1
);

-- ✅ STEP 9 — View Quality Results
select * from DATA_QUALITY_RESULTS;


-- ✅ STEP 10 — Automate Using Snowflake Task
-- First enable task scheduling:
ALTER ACCOUNT SET TIMEZONE = 'Asia/Kolkata';

-- Now create task:
CREATE OR REPLACE TASK RUN_DQ_CHECKS
WAREHOUSE = DE_WH
SCHEDULE = '1 MINUTE'
AS
INSERT INTO DATA_QUALITY_RESULTS
SELECT
    'ROW_COUNT_AUTO',
    CASE 
        WHEN (SELECT COUNT(*) FROM RAW_SALES) =
             (SELECT COUNT(*) FROM STG_SALES)
        THEN 'PASS'
        ELSE 'FAIL'
    END,
    CURRENT_TIMESTAMP()::STRING,
    CURRENT_TIMESTAMP();


-- Start task:
ALTER TASK RUN_DQ_CHECKS RESUME;
-- Now it runs every 1 minute.







