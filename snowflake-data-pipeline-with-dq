-- ✅ STEP 1 — Create Database & Schema
CREATE OR REPLACE DATABASE DE_PROJECT_DB;

USE DATABASE DE_PROJECT_DB;

CREATE OR REPLACE SCHEMA SALES_DWH;

USE SCHEMA SALES_DWH;


-- ✅ STEP 2 — Create Warehouse (Compute)
CREATE OR REPLACE WAREHOUSE DE_WH
WAREHOUSE_SIZE = 'XSMALL'
AUTO_SUSPEND = 60
AUTO_RESUME = TRUE;

USE WAREHOUSE DE_WH;


-- ✅ STEP 3 — Create RAW Table
CREATE OR REPLACE TABLE RAW_SALES (
    ORDER_ID STRING,
    ORDER_DATE DATE,
    CUSTOMER_ID STRING,
    PRODUCT_ID STRING,
    QUANTITY NUMBER,
    PRICE NUMBER,
    UPDATED_AT TIMESTAMP
);


-- ✅ STEP 4 — Insert Sample Data (For Testing)
INSERT INTO RAW_SALES VALUES
